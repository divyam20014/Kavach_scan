# VAPT Workbench — environment variable example (no secrets).
#
# Copy this file to `.env` only if your shell/runner loads .env files automatically; this
# project's backend does NOT read a .env file itself (app/core/settings.py reads real process
# environment variables only). The values below are the defaults — uncomment and change only
# what you need. An unknown VAPT_* variable is a startup error, not a silently ignored typo.
#
# There are no secrets to set here: this app stores no passwords, API keys, or tokens of its
# own. Any credential a scan needs (e.g. an API auth header for the API security module) is
# referenced by an environment-variable NAME or OS-keychain entry name, resolved at scan time —
# never typed into this file or into the app's own settings.

# Bind address. Must be a loopback literal (127.0.0.1 / ::1) or "localhost" — remote binding is
# refused at startup with an explanatory error (no secure remote-access mode exists yet).
# VAPT_HOST=127.0.0.1

# Port the API (and, in production-style `python -m app serve`, the built UI) listens on.
# VAPT_PORT=8765

# Where all application data lives (projects, findings, evidence, reports, audit log). Must be
# an ABSOLUTE path outside the repository checkout. If unset, a per-user default is used
# (see docs/STORAGE_FORMATS.md §1 / docs/DEVELOPMENT.md).
# VAPT_DATA_DIR=/absolute/path/to/your/vapt-data

# Only for contributors intentionally testing against a data directory inside the checkout
# (normally refused). Never set this for real use.
# VAPT_ALLOW_REPO_DATA_DIR=false

# DEBUG, INFO, WARNING, or ERROR.
# VAPT_LOG_LEVEL=INFO

# Advanced / rarely changed (see app/core/settings.py for exact bounds):
# VAPT_LOCK_TIMEOUT_SECONDS=10
# VAPT_AUDIT_ROTATE_BYTES=10485760
# VAPT_MAX_RECORD_BYTES=5242880
# VAPT_MAX_REQUEST_BYTES=1048576
# VAPT_DISK_WARNING_BYTES=2147483648
# VAPT_MAX_ACTIVE_JOBS=1
# VAPT_MAX_QUEUED_JOBS=20

# Dev/test only — enables a network-free self-test scan module used by the backend test suite.
# Never enable this in a normal install.
# VAPT_ENABLE_SELFTEST_JOBS=false
